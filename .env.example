# Network（三仓库统一键名：只填裸 IP 与端口，其余自动组装）
# Node 监听端口
NODE_PORT=5789

# Ctrl（主 API 端口；WSS 接收为独立旁挂端口，见 NODE_CTRL_WSS_URL）
CTRL_IP=127.0.0.1
CTRL_PORT=5000

# ── WSS 推送（Node → Ctrl） ──
# Node 主动连 Ctrl 的 WSS 地址：Ctrl 的 run_wss.py 旁挂端口（CTRL_WSS_PORT，默认 5001）。
# 未设置时回退组装 ws(s)://CTRL_IP:CTRL_PORT/ws/node?uid=...（Ctrl 主端口，仅无旁挂时）
NODE_WSS_ENABLED=0
NODE_CTRL_WSS_URL=wss://127.0.0.1:5001/ws/node
# WSS 连接使用的 Node 客户端证书（Ctrl 的 WSS 服务端按 pin chain 校验）——默认用本机自签证书
# NODE_TLS_CERT_FILE=
# NODE_TLS_KEY_FILE=
# 连接 Ctrl 时校验 Ctrl 服务端证书的信任锚（Ctrl CA 或 Ctrl 证书，人工拷贝到 Node）
# NODE_CTRL_CA_FILE=

# ── HTTPS 操作通道（Ctrl → Node）mTLS ──
# Node 作为 HTTPS 服务端校验 Ctrl 客户端证书的信任锚（Ctrl CA 或 Ctrl 证书，人工拷贝到 Node）。
# 配置后 uvicorn 开启 ssl_cert_reqs=REQUIRED（Node 校验调用者必须为 Ctrl）。
# NODE_CTRL_CA_FILE=

# 容器挂载根目录（生产默认 /home，Node 以 root 运行；开发环境非 root 时改为可写路径，如 /mnt/e/fuxi-data）
NODE_CONTAINERS_BASE=/home
