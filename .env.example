# Network（三仓库统一键名：只填裸 IP 与端口，其余自动组装）
# Node 监听端口。快照的 WSS 端点 /ws/ctrl 与操作通道共用这一个监听。
NODE_PORT=5789

# ── 校验调用者（Ctrl）的信任锚 ──
# Node 作为服务端校验 Ctrl 客户端证书的信任锚（Ctrl CA 或 Ctrl 证书，人工拷贝到 Node）。
# 同时覆盖两条通道：HTTPS 操作通道（Ctrl → Node）与 /ws/ctrl 快照端点（Ctrl → Node）。
# 配置后 uvicorn 开启 ssl_cert_reqs=REQUIRED。
# Node 不需要知道 Ctrl 的地址——两条通道都由 Ctrl 主动发起。
NODE_CTRL_CA_FILE=certs/ctrl_ca.pem

# ── 快照推送 ──
# /ws/ctrl 上每轮推送的间隔（秒）。Ctrl 断线由 Ctrl 自己重连。
NODE_WSS_PUSH_INTERVAL=5

# Node 自签证书与私钥（缺省用 certs/node_cert.pem、certs/node_key.pem）
# NODE_TLS_CERT_FILE=
# NODE_TLS_KEY_FILE=
# 证书 SAN 追加项（逗号分隔，IP 或域名）。Ctrl 按 machine_ip 拨入并做 TOFU pin，
# 已关闭 hostname 校验，通常无需配置；仅在其它调用方需要按域名访问时使用。
# NODE_CERT_ALT_NAMES=

# 容器挂载根目录（生产默认 /home，Node 以 root 运行；开发环境非 root 时改为可写路径，如 /mnt/e/fuxi-data）
NODE_CONTAINERS_BASE=/home

# ── 构建期代理 ──
# 只有在"机器必须走代理才能出外网"的部署里才需要填——镜像构建里的 apt/yum/curl 全在这里面跑。
#
# 为什么写在这儿而不是配 Docker daemon：**daemon 级代理只覆盖拉取，进不了构建的 RUN 步骤**。
# 构建期的代理要靠 Docker 的预定义 build-arg 传进去，而这个 Node 进程的环境变量就是它的来源
# （services/container_service._proxy_build_args 读的就是本进程的 os.environ）。
# run.py 启动时已经加载本文件，所以填在这里即生效。
#
# ⚠ NO_PROXY 必须覆盖内网：Ctrl↔Node 走内网 + 自签证书 + pin 校验，绕进代理会把它打断。
# HTTP_PROXY=http://proxy.example:8091
# HTTPS_PROXY=http://proxy.example:8091
# NO_PROXY=localhost,127.0.0.1,10.0.0.0/8,192.168.0.0/16
